{% extends 'base.html.twig' %}

{% block title %}Météo API et graphiques{% endblock %}

{% block body %}
<style>
    :root { color-scheme: light; font-family: Inter, system-ui, sans-serif; }
    body { margin: 0; background: #f5f7fb; color: #172033; }
    .container { width: min(1120px, calc(100% - 32px)); margin: 38px auto; }
    header { display: flex; justify-content: space-between; align-items: center; gap: 20px; margin-bottom: 24px; }
    h1 { margin: 0 0 6px; font-size: clamp(27px, 4vw, 42px); }
    header p, .muted { color: #667085; margin: 0; }
    .nav { display: flex; align-items: center; gap: 10px; }
    .badge, .link { padding: 9px 14px; border-radius: 999px; font-weight: 700; text-decoration: none; }
    .badge { background: #e9f7ef; color: #087443; }
    .link { background: white; border: 1px solid #dce2eb; color: #344054; }
    .card { background: white; border: 1px solid #e5e9f0; border-radius: 16px; padding: 22px; box-shadow: 0 10px 30px rgba(23,32,51,.06); }
    .search { display: flex; gap: 10px; margin-bottom: 22px; }
    input { flex: 1; min-width: 0; border: 1px solid #ccd3df; border-radius: 10px; padding: 12px 14px; font: inherit; }
    input:focus { outline: 3px solid #dbeafe; border-color: #2563eb; }
    button { border: 0; border-radius: 10px; padding: 12px 20px; color: white; background: #2563eb; font: inherit; font-weight: 750; cursor: pointer; }
    button:disabled { opacity: .55; cursor: wait; }
    .error { display: none; margin-bottom: 18px; padding: 12px; border-radius: 10px; color: #b42318; background: #fff1f1; }
    .summary { display: grid; grid-template-columns: 1.4fr repeat(3, 1fr); gap: 14px; margin-bottom: 22px; }
    .metric { padding: 19px; border-radius: 14px; background: linear-gradient(135deg, #eef6ff, #f8fbff); border: 1px solid #dbeafe; }
    .metric .label { color: #667085; font-size: 13px; font-weight: 650; }
    .metric .value { display: block; margin-top: 7px; font-size: 28px; font-weight: 850; color: #175cd3; }
    .location .value { color: #172033; font-size: 22px; }
    .charts { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
    .chart h2 { margin: 0 0 4px; font-size: 18px; }
    canvas { display: block; width: 100%; height: 280px; margin-top: 14px; }
    .loading { padding: 60px 10px; text-align: center; color: #667085; }
    .source { margin-top: 18px; text-align: right; font-size: 12px; color: #667085; }
    @media (max-width: 780px) { header { align-items: flex-start; flex-direction: column; } .summary, .charts { grid-template-columns: 1fr; } .search { flex-direction: column; } }
</style>

<main class="container">
    <header>
        <div>
            <h1>Météo en temps réel</h1>
            <p>Symfony interroge une API externe puis affiche les données en graphiques.</p>
        </div>
        <nav class="nav">
            <a class="link" href="/products">Produits</a>
            <span class="badge">Mode {{ execution_mode|capitalize }}</span>
        </nav>
    </header>

    <section class="card">
        <form id="weather-form" class="search">
            <input id="city" value="Paris" minlength="2" maxlength="80" required placeholder="Paris, Casablanca, Montréal…">
            <button id="submit" type="submit">Afficher la météo</button>
        </form>
        <div id="error" class="error"></div>
        <div id="dashboard"><div class="loading">Chargement des données météo…</div></div>
    </section>
</main>

<script>
const form = document.querySelector('#weather-form');
const cityInput = document.querySelector('#city');
const dashboard = document.querySelector('#dashboard');
const errorBox = document.querySelector('#error');
const submitButton = document.querySelector('#submit');

function escapeHtml(value) {
    const element = document.createElement('div');
    element.textContent = String(value ?? '');
    return element.innerHTML;
}

function drawChart(canvas, labels, values, options) {
    const ratio = window.devicePixelRatio || 1;
    const width = canvas.clientWidth;
    const height = 280;
    canvas.width = width * ratio;
    canvas.height = height * ratio;
    const ctx = canvas.getContext('2d');
    ctx.scale(ratio, ratio);

    const padding = {left: 42, right: 14, top: 15, bottom: 34};
    const chartWidth = width - padding.left - padding.right;
    const chartHeight = height - padding.top - padding.bottom;
    const min = options.min ?? Math.floor(Math.min(...values) - 2);
    const max = options.max ?? Math.ceil(Math.max(...values) + 2);
    const range = Math.max(max - min, 1);
    const x = index => padding.left + index * chartWidth / Math.max(values.length - 1, 1);
    const y = value => padding.top + (max - value) * chartHeight / range;

    ctx.font = '12px system-ui';
    ctx.fillStyle = '#667085';
    ctx.strokeStyle = '#e5e9f0';
    ctx.lineWidth = 1;
    for (let step = 0; step <= 4; step++) {
        const value = min + range * step / 4;
        const lineY = y(value);
        ctx.beginPath(); ctx.moveTo(padding.left, lineY); ctx.lineTo(width - padding.right, lineY); ctx.stroke();
        ctx.fillText(`${Math.round(value)}${options.unit}`, 3, lineY + 4);
    }

    if (options.bars) {
        const barWidth = Math.max(chartWidth / values.length - 3, 2);
        ctx.fillStyle = options.color;
        values.forEach((value, index) => ctx.fillRect(x(index) - barWidth / 2, y(value), barWidth, y(min) - y(value)));
    } else {
        const gradient = ctx.createLinearGradient(0, padding.top, 0, height - padding.bottom);
        gradient.addColorStop(0, options.fill);
        gradient.addColorStop(1, 'rgba(37,99,235,0)');
        ctx.beginPath();
        values.forEach((value, index) => index ? ctx.lineTo(x(index), y(value)) : ctx.moveTo(x(index), y(value)));
        ctx.lineTo(x(values.length - 1), y(min)); ctx.lineTo(x(0), y(min)); ctx.closePath();
        ctx.fillStyle = gradient; ctx.fill();
        ctx.beginPath();
        values.forEach((value, index) => index ? ctx.lineTo(x(index), y(value)) : ctx.moveTo(x(index), y(value)));
        ctx.strokeStyle = options.color; ctx.lineWidth = 3; ctx.stroke();
    }

    ctx.fillStyle = '#667085';
    labels.forEach((label, index) => {
        if (index % 4 === 0) ctx.fillText(label.slice(11, 16), x(index) - 14, height - 9);
    });
}

async function loadWeather(city) {
    submitButton.disabled = true;
    errorBox.style.display = 'none';
    dashboard.innerHTML = '<div class="loading">Appel de l’API Open-Meteo…</div>';
    try {
        const response = await fetch(`/api/weather?city=${encodeURIComponent(city)}`, {cache: 'no-store'});
        const data = await response.json();
        if (!response.ok) throw new Error(data.error ?? 'Erreur inconnue');

        dashboard.innerHTML = `
            <div class="summary">
                <div class="metric location"><span class="label">Lieu trouvé</span><span class="value">${escapeHtml(data.location.name)}</span><span class="muted">${escapeHtml(data.location.region ?? '')} · ${escapeHtml(data.location.country)}</span></div>
                <div class="metric"><span class="label">Température</span><span class="value">${data.current.temperature_2m} °C</span></div>
                <div class="metric"><span class="label">Ressenti</span><span class="value">${data.current.apparent_temperature} °C</span></div>
                <div class="metric"><span class="label">Vent</span><span class="value">${data.current.wind_speed_10m} km/h</span></div>
            </div>
            <div class="charts">
                <article class="card chart"><h2>Température sur 24 heures</h2><p class="muted">Évolution heure par heure en degrés Celsius</p><canvas id="temperature-chart"></canvas></article>
                <article class="card chart"><h2>Probabilité de pluie</h2><p class="muted">Prévision horaire en pourcentage</p><canvas id="rain-chart"></canvas></article>
            </div>
            <div class="source">Source : ${escapeHtml(data.source)} · Fuseau : ${escapeHtml(data.location.timezone)}</div>`;

        drawChart(document.querySelector('#temperature-chart'), data.hourly.time, data.hourly.temperature, {unit: '°', color: '#2563eb', fill: 'rgba(37,99,235,.28)'});
        drawChart(document.querySelector('#rain-chart'), data.hourly.time, data.hourly.precipitation_probability, {unit: '%', min: 0, max: 100, bars: true, color: '#38bdf8'});
    } catch (error) {
        dashboard.innerHTML = '';
        errorBox.textContent = error.message;
        errorBox.style.display = 'block';
    } finally {
        submitButton.disabled = false;
    }
}

form.addEventListener('submit', event => {
    event.preventDefault();
    loadWeather(cityInput.value.trim());
});
loadWeather('Paris');
</script>
{% endblock %}
