{% extends 'base.html.twig' %}

{% block title %}Connexion aux notifications privées{% endblock %}

{% block body %}
<style>
    :root { color-scheme: light; font-family: Inter, system-ui, sans-serif; }
    body { margin: 0; background: #f4f6fa; color: #172033; }
    main { width: min(480px, calc(100% - 32px)); margin: 60px auto; }
    .card { padding: 26px; border: 1px solid #e2e7ef; border-radius: 16px; background: white; box-shadow: 0 10px 30px rgba(16,24,40,.07); }
    h1 { margin-top: 0; }
    .intro, .help { color: #667085; line-height: 1.6; }
    label { display: block; margin: 15px 0 6px; font-weight: 750; }
    input { box-sizing: border-box; width: 100%; padding: 12px; border: 1px solid #cfd6e2; border-radius: 9px; font: inherit; }
    button { width: 100%; margin-top: 18px; padding: 12px; border: 0; border-radius: 9px; color: white; background: #2563eb; font: inherit; font-weight: 750; cursor: pointer; }
    .accounts { margin-top: 20px; padding: 14px; border-radius: 10px; background: #eef4ff; line-height: 1.7; }
    .error { padding: 12px; border-radius: 9px; color: #b42318; background: #fef3f2; }
</style>

<main>
    <section class="card">
        <h1>Connexion Symfony</h1>
        <p class="intro">Cette fois, l’identité vient de Symfony Security et non d’un paramètre dans l’URL.</p>

        {% if error %}<div class="error">Identifiant ou mot de passe incorrect.</div>{% endif %}

        <form method="post">
            <label for="username">Utilisateur</label>
            <input id="username" name="_username" value="{{ last_username }}" required autofocus>
            <label for="password">Mot de passe</label>
            <input id="password" name="_password" type="password" required>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
            <button type="submit">Se connecter</button>
        </form>

        <div class="accounts">
            <strong>Comptes locaux de démonstration</strong><br>
            <code>amine / mercure1</code><br>
            <code>karim / mercure2</code>
        </div>
    </section>
</main>
{% endblock %}
