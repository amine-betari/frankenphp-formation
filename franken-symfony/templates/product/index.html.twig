{% extends 'base.html.twig' %}

{% block title %}Catalogue Symfony{% endblock %}

{% block body %}
<style>
    :root { color-scheme: light; font-family: Inter, system-ui, sans-serif; }
    body { margin: 0; background: #f3f5f9; color: #172033; }
    .container { width: min(1080px, calc(100% - 32px)); margin: 38px auto; }
    header { display: flex; justify-content: space-between; align-items: center; gap: 20px; margin-bottom: 24px; }
    h1 { margin: 0 0 6px; font-size: clamp(26px, 4vw, 42px); }
    header p { margin: 0; color: #667085; }
    .badge { padding: 9px 14px; border-radius: 999px; background: #e8f1ff; color: #175cd3; font-weight: 700; }
    .weather-link { padding: 9px 14px; border-radius: 999px; background: white; border: 1px solid #dce2eb; color: #344054; font-weight: 700; text-decoration: none; }
    .header-actions { display: flex; align-items: center; gap: 10px; }
    .grid { display: grid; grid-template-columns: minmax(280px, 360px) 1fr; gap: 22px; align-items: start; }
    .card { background: white; border: 1px solid #e5e9f0; border-radius: 16px; padding: 22px; box-shadow: 0 10px 30px rgba(23, 32, 51, .06); }
    h2 { margin: 0 0 18px; font-size: 20px; }
    label { display: block; margin: 13px 0 6px; font-weight: 650; font-size: 14px; }
    input { box-sizing: border-box; width: 100%; border: 1px solid #ccd3df; border-radius: 9px; padding: 11px 12px; font: inherit; }
    input:focus { outline: 3px solid #dbeafe; border-color: #2563eb; }
    button { border: 0; border-radius: 9px; padding: 10px 14px; font: inherit; font-weight: 700; cursor: pointer; }
    .primary { width: 100%; margin-top: 18px; color: white; background: #2563eb; }
    .primary:hover { background: #1d4ed8; }
    .toolbar { display: flex; gap: 10px; margin-bottom: 15px; }
    .toolbar input { flex: 1; }
    .secondary { background: #eef2f7; color: #344054; }
    .danger { background: #fff0f0; color: #c52222; }
    .products { display: grid; gap: 11px; }
    .product { display: grid; grid-template-columns: 1fr auto; gap: 14px; padding: 15px; border: 1px solid #e5e9f0; border-radius: 11px; }
    .product h3 { margin: 0 0 6px; font-size: 17px; }
    .meta { color: #667085; font-size: 14px; }
    .price { color: #175cd3; font-weight: 800; }
    .actions { display: flex; gap: 7px; align-items: center; }
    .message { display: none; margin-top: 15px; border-radius: 9px; padding: 11px; background: #ecfdf3; color: #067647; }
    .message.error { background: #fff1f1; color: #b42318; }
    .empty { padding: 35px 10px; text-align: center; color: #667085; }
    .benchmark { margin-bottom: 22px; display: flex; align-items: center; justify-content: space-between; gap: 20px; }
    .benchmark-copy h2 { margin-bottom: 6px; }
    .benchmark-copy p { margin: 0; color: #667085; }
    .benchmark-actions { display: flex; align-items: center; gap: 14px; }
    .benchmark button { white-space: nowrap; color: white; background: #101828; }
    .benchmark button:disabled { opacity: .55; cursor: wait; }
    .benchmark-result { min-width: 210px; font-size: 14px; line-height: 1.55; color: #344054; }
    .benchmark-result strong { color: #175cd3; font-size: 18px; }
    @media (max-width: 760px) { .grid { grid-template-columns: 1fr; } header { align-items: flex-start; flex-direction: column; } }
    @media (max-width: 760px) { .benchmark, .benchmark-actions { align-items: stretch; flex-direction: column; } .benchmark-result { min-width: 0; } }
</style>

<main class="container">
    <header>
        <div>
            <h1>Catalogue de produits</h1>
            <p>Interface Symfony connectée à l’API JSON.</p>
        </div>
        <div class="header-actions"><a class="weather-link" href="/weather">Météo</a><span class="badge">Mode {{ execution_mode|capitalize }}</span></div>
    </header>

    <section class="card benchmark">
        <div class="benchmark-copy">
            <h2>Test de performance</h2>
            <p>Envoie 200 requêtes à Symfony, avec 10 requêtes simultanées.</p>
        </div>
        <div class="benchmark-actions">
            <div id="benchmark-result" class="benchmark-result">Aucun test lancé.</div>
            <button id="run-benchmark" type="button">Lancer le benchmark</button>
        </div>
    </section>

    <div class="grid">
        <section class="card">
            <h2>Ajouter un produit</h2>
            <form id="create-form">
                <label for="name">Nom</label>
                <input id="name" name="name" required placeholder="Ex. Webcam HD">

                <label for="price">Prix en euros</label>
                <input id="price" name="price" required type="number" min="0" step="0.01" placeholder="49.90">

                <label for="stock">Quantité en stock</label>
                <input id="stock" name="stock" required type="number" min="0" step="1" value="1">

                <button class="primary" type="submit">Créer le produit</button>
            </form>
            <div id="message" class="message" role="status"></div>
        </section>

        <section class="card">
            <h2>Produits enregistrés</h2>
            <div class="toolbar">
                <input id="search" type="search" placeholder="Rechercher par nom…">
                <button id="refresh" class="secondary" type="button">Actualiser</button>
            </div>
            <div id="products" class="products"><div class="empty">Chargement…</div></div>
        </section>
    </div>
</main>

<script>
const list = document.querySelector('#products');
const form = document.querySelector('#create-form');
const search = document.querySelector('#search');
const message = document.querySelector('#message');

function notify(text, error = false) {
    message.textContent = text;
    message.className = `message${error ? ' error' : ''}`;
    message.style.display = 'block';
}

function escapeHtml(value) {
    const element = document.createElement('div');
    element.textContent = value;
    return element.innerHTML;
}

async function loadProducts() {
    const query = encodeURIComponent(search.value.trim());
    const response = await fetch(`/api/products${query ? `?q=${query}` : ''}`);
    const data = await response.json();

    if (!data.items.length) {
        list.innerHTML = '<div class="empty">Aucun produit trouvé.</div>';
        return;
    }

    list.innerHTML = data.items.map(product => `
        <article class="product">
            <div>
                <h3>${escapeHtml(product.name)}</h3>
                <span class="price">${product.price}</span>
                <span class="meta"> · Stock : ${product.stock}</span>
            </div>
            <div class="actions">
                <button class="secondary" onclick="editProduct(${product.id}, ${product.stock})">Modifier</button>
                <button class="danger" onclick="deleteProduct(${product.id})">Supprimer</button>
            </div>
        </article>
    `).join('');
}

form.addEventListener('submit', async event => {
    event.preventDefault();
    const fields = new FormData(form);
    const response = await fetch('/api/products', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({
            name: fields.get('name'),
            price_cents: Math.round(Number(fields.get('price')) * 100),
            stock: Number(fields.get('stock')),
        }),
    });
    const data = await response.json();
    if (!response.ok) {
        notify(data.error ?? 'Création impossible.', true);
        return;
    }
    notify(`Produit « ${data.name} » créé avec l’identifiant ${data.id}.`);
    form.reset();
    document.querySelector('#stock').value = 1;
    await loadProducts();
});

async function editProduct(id, currentStock) {
    const value = prompt('Nouvelle quantité en stock :', currentStock);
    if (value === null) return;
    const stock = Number(value);
    if (!Number.isInteger(stock) || stock < 0) {
        notify('Le stock doit être un entier positif.', true);
        return;
    }
    const response = await fetch(`/api/products/${id}`, {
        method: 'PATCH',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({stock}),
    });
    if (!response.ok) {
        notify('Modification impossible.', true);
        return;
    }
    notify(`Stock du produit ${id} modifié.`);
    await loadProducts();
}

async function deleteProduct(id) {
    if (!confirm('Supprimer définitivement ce produit ?')) return;
    const response = await fetch(`/api/products/${id}`, {method: 'DELETE'});
    if (!response.ok) {
        notify('Suppression impossible.', true);
        return;
    }
    notify(`Produit ${id} supprimé.`);
    await loadProducts();
}

let searchTimer;
search.addEventListener('input', () => {
    clearTimeout(searchTimer);
    searchTimer = setTimeout(loadProducts, 250);
});
document.querySelector('#refresh').addEventListener('click', loadProducts);

document.querySelector('#run-benchmark').addEventListener('click', async event => {
    const button = event.currentTarget;
    const output = document.querySelector('#benchmark-result');
    const totalRequests = 200;
    const concurrency = 10;
    let nextRequest = 0;
    const durations = [];

    button.disabled = true;
    output.textContent = 'Test en cours…';
    const globalStart = performance.now();

    async function client() {
        while (nextRequest < totalRequests) {
            const requestNumber = nextRequest++;
            const start = performance.now();
            const response = await fetch(`/api/test?benchmark=${Date.now()}-${requestNumber}`, {cache: 'no-store'});
            if (!response.ok) throw new Error(`HTTP ${response.status}`);
            await response.json();
            durations.push(performance.now() - start);
        }
    }

    try {
        await Promise.all(Array.from({length: concurrency}, client));
        const totalTime = performance.now() - globalStart;
        const average = durations.reduce((sum, value) => sum + value, 0) / durations.length;
        const sorted = [...durations].sort((a, b) => a - b);
        const p95 = sorted[Math.floor(sorted.length * .95)];
        const requestsPerSecond = totalRequests / (totalTime / 1000);

        output.innerHTML = `<strong>${requestsPerSecond.toFixed(1)} req/s</strong><br>` +
            `${totalTime.toFixed(0)} ms au total · ${average.toFixed(1)} ms moyen · p95 ${p95.toFixed(1)} ms`;
    } catch (error) {
        output.textContent = `Échec du test : ${error.message}`;
    } finally {
        button.disabled = false;
    }
});

loadProducts().catch(() => notify('Impossible de contacter l’API.', true));
</script>
{% endblock %}
