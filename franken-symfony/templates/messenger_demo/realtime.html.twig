{% extends 'base.html.twig' %}

{% block title %}Messenger avec Mercure{% endblock %}

{% block body %}
<style>
    :root { color-scheme: light; font-family: Inter, system-ui, sans-serif; }
    body { margin: 0; background: #f4f6fa; color: #172033; }
    main { width: min(880px, calc(100% - 32px)); margin: 42px auto; }
    h1 { margin-bottom: 8px; font-size: clamp(30px, 5vw, 44px); }
    .intro { color: #667085; line-height: 1.6; }
    .comparison { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin: 24px 0; }
    .comparison a, .comparison div { padding: 16px; border: 1px solid #dce3ee; border-radius: 11px; background: white; color: #344054; text-decoration: none; }
    .comparison .active { border: 2px solid #12b76a; background: #ecfdf3; }
    .card { padding: 24px; border: 1px solid #e2e7ef; border-radius: 16px; background: white; box-shadow: 0 10px 30px rgba(16,24,40,.06); }
    button { padding: 13px 19px; border: 0; border-radius: 10px; color: white; background: #067647; font: inherit; font-weight: 800; cursor: pointer; }
    button.danger { margin-left: 8px; background: #b42318; }
    button:disabled { opacity: .55; }
    .connection { margin: 15px 0; color: #b54708; }
    .connection.connected { color: #067647; }
    .status { margin-top: 16px; padding: 18px; border-radius: 11px; background: #f8fafc; }
    .bar { height: 12px; margin: 12px 0; overflow: hidden; border-radius: 99px; background: #e4e7ec; }
    .bar span { display: block; width: 0; height: 100%; background: #12b76a; transition: width .3s; }
    dl { display: grid; grid-template-columns: 170px 1fr; gap: 8px; }
    dt { color: #667085; }
    dd { margin: 0; font-weight: 700; }
    pre { overflow: auto; padding: 14px; border-radius: 9px; color: #e6edf3; background: #101828; }
    @media (max-width: 650px) { .comparison { grid-template-columns: 1fr; } }
</style>

<main>
    <h1>Messenger + Mercure</h1>
    <p class="intro">Le Worker Messenger pousse maintenant la progression vers Mercure. Le navigateur ne demande plus régulièrement l'état de la tâche.</p>

    <div class="comparison">
        <a href="/messenger-demo"><strong>Version 1 · Polling</strong><br>une requête d'état toutes les 500 ms</a>
        <div class="active"><strong>Version 2 · Mercure</strong><br>une connexion ouverte, événements poussés en direct</div>
    </div>

    <section class="card">
        <button id="start" type="button" disabled>Générer le rapport</button>
        <button id="start-failure" class="danger" type="button" disabled>Simuler une erreur</button>
        <div id="connection" class="connection">Connexion au Hub Mercure…</div>
        <div class="status">
            <div class="bar"><span id="progress"></span></div>
            <dl>
                <dt>État</dt><dd id="state">—</dd>
                <dt>Job ID</dt><dd id="job-id">—</dd>
                <dt>Requêtes de statut</dt><dd id="poll-count">0</dd>
                <dt>Événements Mercure</dt><dd id="event-count">0</dd>
                <dt>Tentative</dt><dd id="attempt">—</dd>
                <dt>Worker Messenger</dt><dd id="worker-process">—</dd>
            </dl>
            <pre id="result">Le résultat apparaîtra ici.</pre>
        </div>
    </section>
</main>

<script>
const button = document.querySelector('#start');
const failureButton = document.querySelector('#start-failure');
const connection = document.querySelector('#connection');
const state = document.querySelector('#state');
const progress = document.querySelector('#progress');
const eventCount = document.querySelector('#event-count');
const attempt = document.querySelector('#attempt');
const workerProcess = document.querySelector('#worker-process');
const result = document.querySelector('#result');
const bufferedEvents = new Map();
let currentJobId = null;
let receivedEvents = 0;

const eventSource = new EventSource({{ mercure(topic)|json_encode|raw }});

eventSource.onopen = () => {
    connection.className = 'connection connected';
    connection.textContent = 'Connecté à Mercure — aucune requête de statut nécessaire';
    button.disabled = false;
    failureButton.disabled = false;
};

eventSource.onerror = () => {
    connection.className = 'connection';
    connection.textContent = 'Connexion perdue — EventSource tente de se reconnecter…';
    button.disabled = true;
    failureButton.disabled = true;
};

function displayJob(job) {
    receivedEvents++;
    eventCount.textContent = receivedEvents;
    state.textContent = `${job.status} — ${job.message}`;
    progress.style.width = `${job.progress}%`;
    progress.style.background = job.status === 'failed' ? '#d92d20' : '#12b76a';
    attempt.textContent = job.attempt ? `${job.attempt} / ${job.max_attempts}` : '—';
    workerProcess.textContent = `${job.worker_instance} · PID ${job.worker_pid}`;

    if (job.status === 'completed') {
        result.textContent = JSON.stringify(job.result, null, 2);
        button.disabled = false;
        failureButton.disabled = false;
    }

    if (job.status === 'retrying') {
        result.textContent = `${job.error}\nMessenger conserve le message et programmera une nouvelle tentative.`;
    }

    if (job.status === 'failed') {
        result.textContent = `${job.error}\nLe message peut maintenant être inspecté ou relancé depuis la file failed.`;
        button.disabled = false;
        failureButton.disabled = false;
    }
}

eventSource.onmessage = event => {
    const job = JSON.parse(event.data);
    if (job.id === currentJobId) {
        displayJob(job);
    } else {
        const jobEvents = bufferedEvents.get(job.id) ?? [];
        jobEvents.push(job);
        bufferedEvents.set(job.id, jobEvents);
    }
};

async function startJob(shouldFail) {
    button.disabled = true;
    failureButton.disabled = true;
    receivedEvents = 0;
    eventCount.textContent = '0';
    progress.style.width = '0%';
    state.textContent = 'Envoi de la tâche…';
    attempt.textContent = '—';
    result.textContent = 'La requête HTTP est partie…';

    const response = await fetch('/api/messenger/jobs', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({fail: shouldFail}),
    });
    const job = await response.json();
    currentJobId = job.job_id;
    document.querySelector('#job-id').textContent = currentJobId;
    state.textContent = 'queued — tâche placée dans Messenger';

    if (bufferedEvents.has(currentJobId)) {
        bufferedEvents.get(currentJobId).forEach(displayJob);
        bufferedEvents.delete(currentJobId);
    }
}

button.addEventListener('click', () => startJob(false));
failureButton.addEventListener('click', () => startJob(true));
</script>
{% endblock %}
